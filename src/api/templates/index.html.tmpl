<!DOCTYPE html>
<html lang="en">
<head>
    {{template "head"}}
    <title>Quote Dropper</title>
    <meta name="description" content="The quote collection and public API behind the Quote Droplet apps.">
</head>
<body>
    {{template "header" "home"}}

    <main>
        <div class="wrap">
            <section class="hero" aria-live="polite">
                <p class="eyebrow">A quote for right now</p>
                <p class="hero-quote" id="heroQuote">&nbsp;</p>
                <p class="hero-author" id="heroAuthor">&nbsp;</p>
                <div class="hero-actions">
                    <button type="button" class="btn" id="nextQuote">Another quote</button>
                    <a href="/quotes" class="btn secondary" id="browseAll">Browse all quotes</a>
                </div>
            </section>

            <section class="block">
                <h2 class="section-title">Browse by category</h2>
                <p class="section-sub">Every quote is reviewed before it shows up here or in the apps.</p>
                <div class="chips">
                    <a class="chip" href="/quotes?classification=wisdom">Wisdom</a>
                    <a class="chip" href="/quotes?classification=motivation">Motivation</a>
                    <a class="chip" href="/quotes?classification=discipline">Discipline</a>
                    <a class="chip" href="/quotes?classification=philosophy">Philosophy</a>
                    <a class="chip" href="/quotes?classification=inspiration">Inspiration</a>
                    <a class="chip" href="/quotes?classification=upliftment">Upliftment</a>
                    <a class="chip" href="/quotes?classification=love">Love</a>
                    <a class="chip" href="/quotes?maxLength=100">Short (100 characters or less)</a>
                </div>
            </section>

            <section class="block">
                <h2 class="section-title">Know a good quote?</h2>
                <p class="section-sub">Send it in. Once it's approved, it reaches everyone using Quote Droplet.</p>
                <div class="hero-actions">
                    <a href="/submit-quote" class="btn">Submit a quote</a>
                    <a href="/submit-feedback" class="btn secondary">Send feedback</a>
                </div>
            </section>

            <section class="block" id="api">
                <h2 class="section-title">API</h2>
                <p class="section-sub">Free and public, JSON by default. Base URL <code>https://quotedropper.up.railway.app</code>. Limited to 60 requests a minute.</p>
                <div class="endpoints">
                    <div class="endpoint"><span class="method">GET</span><a class="path" href="/quotes">/quotes</a><span class="desc">Approved quotes. Filter with <code>classification</code>, <code>author</code>, <code>maxLength</code> or <code>search</code>.</span></div>
                    <div class="endpoint"><span class="method">GET</span><a class="path" href="/quotes/random">/quotes/random</a><span class="desc">One random quote. Takes <code>classification</code> and <code>maxLength</code>.</span></div>
                    <div class="endpoint"><span class="method">GET</span><a class="path" href="/quotes/recent">/quotes/recent</a><span class="desc">Newest approved quotes. <code>limit</code> up to 10.</span></div>
                    <div class="endpoint"><span class="method">GET</span><a class="path" href="/quotes/top">/quotes/top</a><span class="desc">Most liked quotes. Optional <code>category</code>.</span></div>
                    <div class="endpoint"><span class="method">GET</span><span class="path">/quotes/:id</span><span class="desc">A single quote by ID.</span></div>
                    <div class="endpoint"><span class="method">GET</span><a class="path" href="/quotes/count">/quotes/count</a><span class="desc">How many quotes there are. Optional <code>category</code>.</span></div>
                    <div class="endpoint"><span class="method">GET</span><a class="path" href="/categories">/categories</a><span class="desc">Every category in use.</span></div>
                    <div class="endpoint"><span class="method">POST</span><span class="path">/quotes</span><span class="desc">Submit a quote for review: <code>text</code>, <code>author</code>, <code>classification</code>.</span></div>
                    <div class="endpoint"><span class="method">POST</span><span class="path">/quotes/:id/like</span><span class="desc">Like a quote. <code>DELETE</code> the same path to unlike.</span></div>
                </div>
            </section>

            <section class="block">
                <h2 class="section-title">The apps</h2>
                <p class="section-sub">Quote Droplet puts these quotes on your home screen, lock screen and menu bar.</p>
                <div class="apps">
                    <a class="app" href="https://apps.apple.com/app/id6455084603">
                        <p class="app-name">Quote Droplet for iPhone and iPad</p>
                        <p class="app-desc">Widgets, daily notifications, search and saved quotes.</p>
                    </a>
                    <a class="app" href="https://apps.apple.com/app/id6455084603">
                        <p class="app-name">Quote Droplet for Mac</p>
                        <p class="app-desc">A quote in your menu bar, refreshed on your schedule.</p>
                    </a>
                    <a class="app" href="https://github.com/Daggerpov/Quote-Droplet-iOS">
                        <p class="app-name">Source code</p>
                        <p class="app-desc">The iOS, Mac and API code is all open on GitHub.</p>
                    </a>
                </div>
            </section>
        </div>
    </main>

    {{template "footer"}}

    <script>
        (function () {
            const quoteEl = document.getElementById('heroQuote');
            const authorEl = document.getElementById('heroAuthor');
            const browseAll = document.getElementById('browseAll');
            const invalidAuthors = ['', 'unknown author', 'null', 'unknown'];

            function showQuote(q) {
                quoteEl.textContent = '“' + q.text.trim() + '”';
                const author = (q.author || '').trim();
                authorEl.textContent = invalidAuthors.includes(author.toLowerCase()) ? ' ' : author;
            }

            function loadQuote() {
                fetch('/quotes/random?maxLength=180', { headers: { Accept: 'application/json' } })
                    .then(r => r.ok ? r.json() : Promise.reject())
                    .then(showQuote)
                    .catch(() => {
                        quoteEl.textContent = '“The best way out is always through.”';
                        authorEl.textContent = 'Robert Frost';
                    });
            }

            fetch('/quotes/count', { headers: { Accept: 'application/json' } })
                .then(r => r.json())
                .then(d => { if (d.count) browseAll.textContent = 'Browse all ' + d.count.toLocaleString() + ' quotes'; })
                .catch(() => {});

            document.getElementById('nextQuote').addEventListener('click', loadQuote);
            loadQuote();
        })();
    </script>
</body>
</html>
