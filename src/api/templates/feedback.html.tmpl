<!DOCTYPE html>
<html lang="en">
<head>
    {{template "head"}}
    <title>Send feedback · Quote Dropper</title>
</head>
<body>
    {{template "header" "feedback"}}

    <main class="wrap narrow">
        <div class="page-head">
            <p class="eyebrow">Feedback</p>
            <h1 class="page-title">Send feedback</h1>
            <p class="lede">Bug reports, feature ideas and anything else about Quote Droplet. A screenshot helps with bugs.</p>
        </div>

        <div class="card">
            <form id="feedbackForm">
                <div class="field">
                    <label for="feedbackType">Type</label>
                    <select id="feedbackType" name="feedbackType">
                        <option value="general" selected>General feedback</option>
                        <option value="bug">Bug report</option>
                        <option value="feature">Feature request</option>
                    </select>
                </div>

                <div class="field">
                    <label for="feedback">Feedback</label>
                    <textarea id="feedback" name="feedback" placeholder="What happened, or what would you like to see?"></textarea>
                </div>

                <div class="field">
                    <label for="name">Your name or alias <span class="optional">optional</span></label>
                    <input type="text" id="name" name="name">
                </div>

                <div class="field">
                    <label for="image">Screenshot <span class="optional">optional</span></label>
                    <input type="file" id="image" name="image" accept="image/*">
                </div>

                <button type="submit" class="btn block">Send feedback</button>
            </form>
            <div id="submissionMessage" class="message" style="display: none;"></div>
        </div>
    </main>

    {{template "footer"}}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const feedbackForm = document.getElementById('feedbackForm');
            const submissionMessage = document.getElementById('submissionMessage');

            feedbackForm.addEventListener('submit', function(event) {
                event.preventDefault();

                // Get form values
                const feedbackType = document.getElementById('feedbackType').value;
                const name = document.getElementById('name').value;
                const feedback = document.getElementById('feedback').value;
                const imageFile = document.getElementById('image').files[0];

                // Validate feedback content
                if (!feedback.trim()) {
                    showMessage('Please enter your feedback before submitting.', 'error');
                    return;
                }

                // Create FormData object to handle file upload
                const formData = new FormData();
                formData.append('type', feedbackType);
                formData.append('name', name);
                formData.append('content', feedback);
                
                if (imageFile) {
                    formData.append('image', imageFile);
                }

                // Submit feedback
                fetch('/submit-feedback', {
                    method: 'POST',
                    body: formData
                })
                .then(response => {
                    if (response.ok) {
                        return response.json();
                    }
                    throw new Error('Failed to submit feedback');
                })
                .then(data => {
                    // Clear form
                    feedbackForm.reset();
                    // Show success message
                    showMessage('Thanks, your feedback was sent.', 'success');
                })
                .catch(error => {
                    console.error('Error:', error);
                    showMessage('There was an error submitting your feedback. Please try again.', 'error');
                });
            });

            function showMessage(message, type) {
                submissionMessage.textContent = message;
                submissionMessage.className = `message ${type}`;
                submissionMessage.style.display = 'block';
                
                // Automatically hide the message after 5 seconds
                setTimeout(() => {
                    submissionMessage.style.display = 'none';
                }, 5000);
            }
        });
    </script>
</body>
</html>
