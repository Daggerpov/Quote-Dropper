<!DOCTYPE html>
<html lang="en">
<head>
    {{template "head"}}
    <title>{{.Title}} · Quote Dropper</title>
</head>
<body>
    {{template "header" "quotes"}}

    <main class="wrap">
        <div class="page-head">
            <p class="eyebrow">Quotes</p>
            <h1 class="page-title">{{.Title}}</h1>
            {{if .Description}}<p class="lede">{{.Description}}</p>{{end}}
        </div>

        {{if ne (len .Quotes) 1}}
        <div class="toolbar">
            <input type="search" id="searchBox" placeholder="Search by text, author or category" aria-label="Search quotes">
            <div class="filter-row">
                <span class="filter-label">Length</span>
                <button type="button" class="chip" data-filter="length" data-value="all">Any</button>
                <button type="button" class="chip" data-filter="length" data-value="100">100 or less</button>
                <button type="button" class="chip" data-filter="length" data-value="60">60 or less</button>
            </div>
            <div class="filter-row" id="categoryNav">
                <span class="filter-label">Category</span>
                <button type="button" class="chip" data-filter="category" data-value="all">All</button>
            </div>
        </div>

        {{if .Stats}}
        <p class="result-count" id="statsCount" data-total="{{.Stats.Count}}">{{.Stats.Count}} quotes</p>
        {{end}}
        {{else}}
        <p class="result-count"><a href="/quotes">All quotes</a></p>
        {{end}}

        {{if .Quotes}}
        <div class="quote-list" id="quoteGrid">
            {{range .Quotes}}
            <article class="quote-item" data-quote-text="{{.Text}}" data-quote-author="{{.Author}}" data-quote-classification="{{.Classification}}">
                <blockquote>&ldquo;{{.Text}}&rdquo;</blockquote>
                <div class="quote-meta">
                    {{if isAuthorValid .Author}}<span class="author">{{.Author}}</span>{{end}}
                    <span>{{.Classification}}</span>
                    <span>{{.Likes}} {{if eq .Likes 1}}like{{else}}likes{{end}}</span>
                    <span class="spacer"></span>
                    <button type="button" class="link-btn" onclick="copyQuote(this)" data-text="{{.Text}}" data-author="{{if isAuthorValid .Author}}{{.Author}}{{end}}">Copy</button>
                    <a class="link-btn" href="/quotes/{{.ID}}">#{{.ID}}</a>
                </div>
            </article>
            {{end}}
        </div>
        <div class="empty hidden" id="emptyState">
            <h2>Nothing matches that search</h2>
            <p>Try other words, or clear the search.</p>
        </div>
        {{else}}
        <div class="empty" id="emptyState">
            <h2>No quotes found</h2>
            <p>Try a different filter, or <a href="/quotes">see every quote</a>.</p>
        </div>
        {{end}}
    </main>

    {{template "footer"}}

    <div id="copyFeedback" class="toast" role="status">Copied</div>

    <script>
        const searchBox = document.getElementById('searchBox');
        const quoteCards = document.querySelectorAll('.quote-item');
        const statsCount = document.getElementById('statsCount');
        const emptyState = document.getElementById('emptyState');
        const quoteGrid = document.getElementById('quoteGrid');
        const params = new URLSearchParams(window.location.search);
        let lengthFilter = ['60', '100'].includes(params.get('maxLength')) ? params.get('maxLength') : 'all';
        let categoryFilter = params.get('classification') || 'all';

        function copyQuote(button) {
            const author = button.getAttribute('data-author');
            let formatted = '“' + button.getAttribute('data-text') + '”';
            if (author && author.trim()) formatted += ' — ' + author;

            const done = () => {
                const toast = document.getElementById('copyFeedback');
                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 1600);
            };
            navigator.clipboard.writeText(formatted).then(done).catch(() => {
                const ta = document.createElement('textarea');
                ta.value = formatted;
                document.body.appendChild(ta);
                ta.select();
                try { document.execCommand('copy'); done(); } catch (e) { console.error(e); }
                document.body.removeChild(ta);
            });
        }

        function markActive() {
            document.querySelectorAll('.chip[data-filter]').forEach(chip => {
                const current = chip.dataset.filter === 'length' ? lengthFilter : categoryFilter;
                chip.setAttribute('aria-current', chip.dataset.value === current ? 'true' : 'false');
            });
        }

        function navigate() {
            const next = new URLSearchParams();
            if (categoryFilter !== 'all') next.append('classification', categoryFilter);
            if (lengthFilter !== 'all') next.append('maxLength', lengthFilter);
            const qs = next.toString();
            window.location.href = qs ? '/quotes?' + qs : '/quotes';
        }

        document.addEventListener('click', event => {
            const chip = event.target.closest('.chip[data-filter]');
            if (!chip) return;
            if (chip.dataset.filter === 'length') lengthFilter = chip.dataset.value;
            else categoryFilter = chip.dataset.value;
            navigate();
        });

        fetch('/categories', { headers: { Accept: 'application/json' } })
            .then(r => r.json())
            .then(data => {
                const nav = document.getElementById('categoryNav');
                if (!nav) return;
                (data.categories || []).sort().forEach(category => {
                    const chip = document.createElement('button');
                    chip.type = 'button';
                    chip.className = 'chip';
                    chip.dataset.filter = 'category';
                    chip.dataset.value = category;
                    chip.textContent = category.charAt(0).toUpperCase() + category.slice(1);
                    nav.appendChild(chip);
                });
                markActive();
            })
            .catch(err => console.error('Failed to load categories:', err));

        markActive();

        if (searchBox) searchBox.addEventListener('input', () => {
            const term = searchBox.value.toLowerCase().trim();
            let visible = 0;
            quoteCards.forEach(card => {
                const hay = (card.dataset.quoteText + ' ' + card.dataset.quoteAuthor + ' ' + card.dataset.quoteClassification).toLowerCase();
                const match = term === '' || hay.includes(term);
                card.classList.toggle('hidden', !match);
                if (match) visible++;
            });
            if (statsCount) {
                const n = term === '' ? statsCount.dataset.total : visible;
                statsCount.textContent = n + (n == 1 ? ' quote' : ' quotes');
            }
            if (quoteGrid && emptyState) {
                const none = visible === 0 && term !== '';
                emptyState.classList.toggle('hidden', !none);
                quoteGrid.style.display = none ? 'none' : '';
            }
        });

        document.addEventListener('keydown', e => {
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                e.preventDefault();
                if (searchBox) searchBox.focus();
            }
        });
    </script>
</body>
</html>
